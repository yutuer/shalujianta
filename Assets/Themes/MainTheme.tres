[gd_resource type="Theme" load_steps=9 format=3]

; FishEatFish 统一视觉主题（对照参考图 R-01 / R-04 / R-12）
;   - 底色深蓝灰（不是纯黑）
;   - 分割线与边框用极细金线
;   - 标题用衬线中文（配合 TitleFont.tres）
;
; 注意：这里**只定义颜色与边框**，不设 content_margin、不改 default_font_size ——
; 一旦改动控件尺寸，现有线框布局（按钮并排、HBox 排列）就会被挤爆。

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_button_normal"]
